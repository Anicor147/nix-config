# ==========================================
# Nix & NixOS Specifics
# ==========================================
# Build outputs generated by 'nix build' or 'nixos-rebuild'
result
result-*

# Persistent environment folders used by direnv / nix-shell
.direnv/
.bash_history

# Backup files generated by NixOS during configuration updates
*.bak
*.old
*~

# ==========================================
# Hardware / Machine Specifics (Optional)
# ==========================================
# If you decide to generate hardware configs dynamically,
# keep the main hardware-configuration.nix but ignore backups
hardware-configuration.nix
hardware-configuration.nix.bak

# ==========================================
# Security & Secret Prevention (CRITICAL)
# ==========================================
# Generic folder names where you might store local secrets
secrets/
secret/
.env/

# Common extensions for files containing keys or tokens
*.secret
*.env
.envrc
*.pem
*.key
id_rsa
id_ed25519

